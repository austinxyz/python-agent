# LLM Provider: 'anthropic' (default) or 'openai'
LLM_PROVIDER=anthropic

# Anthropic API key (required when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI API key (ALWAYS required — used for embeddings regardless of LLM_PROVIDER)
OPENAI_API_KEY=sk-your-key-here

# LLM model to use (e.g. claude-haiku-4-5-20251001, gpt-4o)
LLM_MODEL=claude-haiku-4-5-20251001

# Embedding model (OpenAI text-embedding-3-small is the V1 hard dependency)
EMBEDDING_MODEL=text-embedding-3-small

# Qdrant connection (matches docker-compose service name)
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Flask secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-random-secret

# Path where uploaded files are stored (mounted Docker volume in production)
UPLOADS_PATH=/app/uploads
