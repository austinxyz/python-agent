# LLM Provider: 'anthropic' (default) or 'openai'
LLM_PROVIDER=anthropic

# Anthropic API key (required when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI API key (ALWAYS required — used for embeddings regardless of LLM_PROVIDER)
OPENAI_API_KEY=sk-your-key-here

# LLM model to use (e.g. claude-haiku-4-5-20251001, gpt-4o)
LLM_MODEL=claude-haiku-4-5-20251001

# Embedding model (OpenAI text-embedding-3-small is the V1 hard dependency)
EMBEDDING_MODEL=text-embedding-3-small

# Qdrant connection (matches docker-compose service name)
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# Flask secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-random-secret

# Path where uploaded files are stored (mounted Docker volume in production)
UPLOADS_PATH=/app/uploads

# SQLite database path (mounted Docker volume in production)
SQLITE_PATH=/app/data/knowledge_agent.db

# multi-user-auth-core — required from this change forward.
# Bootstrap reads INITIAL_ADMIN_EMAIL on first startup of an empty users
# table; creates admin row + prints invite URL to stdout (visible via
# `docker logs <api-container>`).
INITIAL_ADMIN_EMAIL=you@example.com

# Base URL embedded in invite URLs (admin opens this in a browser).
# Local dev: http://localhost:3000. NAS: http://10.0.0.20:8910.
APP_BASE_URL=http://localhost:3000

# Session cookie Secure attribute. Set false for plain HTTP (NAS today + local
# dev); set true once HTTPS is in front of the app.
SESSION_COOKIE_SECURE=false

# Optional: Google Identity Services. If unset, the GSI button is hidden.
# Works only on HTTPS or localhost (browser policy).
# GOOGLE_CLIENT_ID=
